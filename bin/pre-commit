#!/usr/bin/env bash
# pre-commit — keep the screenplay SOURCE and its rendered PDF in lock-step.
#
# Project-parameterized: reads PROJECT_PROFILE §0 (Claude Docs/PROJECT_PROFILE.md)
# for the source/PDF/derived filenames, so it works on ANY screenplay, not just one.
# It supports two source containers, dispatched on which §0 field is set:
#   - source.highland set  → HIGHLAND mode: the source is a .highland bundle; the
#     screenplay text is text.md inside its textbundle (which IS Fountain).
#   - source.highland null → FOUNTAIN mode: the source is a committed full Fountain
#     file (the file named in §0 source.text_mirror), exported from any tool —
#     Final Draft, Highland, Fathom, WriterDuet, etc. No companion app required.
# (A future `fdx` container would convert .fdx → Fountain first; not handled here.)
#
# In both modes: hash the source text; if it changed, REQUIRE the re-exported PDF in
# the same commit; then derive the body-only .fountain (for the cue extractor),
# regenerate the paged HTML, and record the new hash in .script-state.
#
# Dependencies: bash, git, unzip, shasum, awk. No external services.
# Install on a fresh clone:  git config core.hooksPath .githooks
set -e

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

STATE_FILE=".script-state"
PROFILE="Claude Docs/PROJECT_PROFILE.md"

# --- read §0 values (quoted strings; empty if absent/null) ---
pv() { [ -f "$PROFILE" ] || return 0; grep -m1 -E "^[[:space:]]*$1:[[:space:]]*\"" "$PROFILE" 2>/dev/null | sed -E 's/^[^"]*"([^"]+)".*/\1/' || true; }
HIGHLAND_PATH="$(pv highland)"
PDF_PATH="$(pv pdf)"
TEXT_MIRROR="$(pv text_mirror)"
FOUNTAIN_PATH="$(pv fountain)"   # the DERIVED body-only fountain (must differ from text_mirror)

# No profile → no per-project config to read; nothing for this hook to enforce.
# (Silent: the hook is harmless until the project is onboarded with a PROJECT_PROFILE.)
[ -f "$PROFILE" ] || exit 0

TMP_DIR="$(mktemp -d)"; trap 'rm -rf "$TMP_DIR"' EXIT
TMP_TEXT="$TMP_DIR/full.txt"
SRC_STAGED=""

# --- locate the staged SOURCE and extract its FULL text into $TMP_TEXT ---
if [ -n "$HIGHLAND_PATH" ]; then
    # HIGHLAND mode: find the staged .highland (it may be renamed, so match by extension).
    SRC_STAGED="$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.highland$' | head -n 1 || true)"
    [ -z "$SRC_STAGED" ] && exit 0   # no .highland in this commit — nothing to do
    TMP_BUNDLE="$TMP_DIR/bundle.highland"
    git show ":${SRC_STAGED}" > "$TMP_BUNDLE"
    TEXT_PATH="$(unzip -Z1 "$TMP_BUNDLE" 2>/dev/null | grep -E '\.textbundle/text\.md$' | head -n 1)"
    if [ -z "$TEXT_PATH" ]; then
        echo "pre-commit: WARNING — no <textbundle>/text.md inside '$SRC_STAGED'; allowing commit, review manually." >&2
        exit 0
    fi
    unzip -p "$TMP_BUNDLE" "$TEXT_PATH" > "$TMP_TEXT" 2>/dev/null || true
else
    # FOUNTAIN mode: the source is the committed full Fountain file named in §0 text_mirror.
    if [ -z "$TEXT_MIRROR" ]; then exit 0; fi
    SRC_STAGED="$(git diff --cached --name-only --diff-filter=ACM | grep -F -x "$TEXT_MIRROR" | head -n 1 || true)"
    [ -z "$SRC_STAGED" ] && exit 0   # the source file isn't in this commit — nothing to do
    git show ":${SRC_STAGED}" > "$TMP_TEXT"
fi

[ -s "$TMP_TEXT" ] || { echo "pre-commit: WARNING — source text is empty; allowing commit." >&2; exit 0; }

# --- hash the source text, compare to the recorded baseline ---
NEW_HASH="$(shasum -a 256 "$TMP_TEXT" | awk '{print $1}')"
OLD_HASH=""
[ -f "$STATE_FILE" ] && OLD_HASH="$(awk -F= '$1=="text_md_sha256"{print $2}' "$STATE_FILE" | tr -d '[:space:]')"
[ "$NEW_HASH" = "$OLD_HASH" ] && exit 0   # UI-only save / no text change

# --- changed → require the rendered PDF in this same commit ---
if [ -n "$PDF_PATH" ]; then
    PDF_STAGED="$(git diff --cached --name-only --diff-filter=ACM | grep -F -x "$PDF_PATH" || true)"
    if [ -z "$PDF_STAGED" ]; then
        cat >&2 <<EOF

pre-commit: BLOCKED — screenplay text changed but the PDF was not re-exported.
    old: ${OLD_HASH:-<none recorded>}
    new: $NEW_HASH

Re-export the PDF from your screenwriting app, save over:
    $PDF_PATH

then stage both and retry:
    git add "$SRC_STAGED" "$PDF_PATH" && git commit ...

Page count and all derived facts in this repo depend on the rendered PDF. This hook
does not run your app for you — its job is to keep the script and its pagination in
lock-step.

EOF
        exit 1
    fi
fi

# --- record the new baseline, re-stage .script-state ---
{
    echo "text_md_sha256=$NEW_HASH"
    echo "source_path=$SRC_STAGED"
    echo "updated_at=$(date -u +%Y-%m-%dT%H:%M:%SZ)"
} > "$STATE_FILE"
if ! git add "$STATE_FILE"; then
    echo "pre-commit: ERROR — failed to stage updated $STATE_FILE; aborting so the baseline can't desync." >&2
    exit 1
fi

# --- derive the body-only .fountain (strip the Fountain title page) for the extractor ---
# (Skipped if §0 source.fountain == text_mirror, to avoid overwriting the writer's source.)
if [ -n "$FOUNTAIN_PATH" ] && [ "$FOUNTAIN_PATH" != "$TEXT_MIRROR" ]; then
    if awk 'f || /^(INT|EXT|EST|I\/E)[.\/ ]/ {f=1} f' "$TMP_TEXT" > "$FOUNTAIN_PATH" && [ -s "$FOUNTAIN_PATH" ]; then
        git add "$FOUNTAIN_PATH" && echo "pre-commit: re-derived $FOUNTAIN_PATH (body only) from the screenplay." \
            || echo "pre-commit: WARNING — could not stage $FOUNTAIN_PATH." >&2
    else
        echo "pre-commit: WARNING — could not re-derive $FOUNTAIN_PATH." >&2
    fi
fi

# --- regenerate the paged HTML reader (gitignored output; non-fatal) ---
HTML_OUT="Claude Docs/generated/script_paged.html"
if command -v python3 >/dev/null 2>&1 && [ -f scripts/script_to_html_paged.py ]; then
    mkdir -p "Claude Docs/generated" 2>/dev/null || true
    python3 scripts/script_to_html_paged.py --input "$TMP_TEXT" --out "$HTML_OUT" >/dev/null 2>&1 \
        && echo "pre-commit: regenerated $HTML_OUT (paste into your web reader)." \
        || echo "pre-commit: WARNING — $HTML_OUT regen failed (non-blocking)." >&2
fi

echo "pre-commit: script-state updated (source sha256: ${NEW_HASH:0:12}…). PDF staged. Proceeding."
exit 0
